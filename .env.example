# MySQL (XAMPP / MySQL Workbench / Laragon…). Prisma sẽ tự tạo database nếu chưa có.
DATABASE_URL="mysql://root:@localhost:3306/restaurant_db"

# Khoá ký phiên đăng nhập nhân viên (đổi thành chuỗi ngẫu nhiên dài ≥ 32 ký tự khi triển khai)
AUTH_SECRET="dev-only-secret-change-me-in-env-file-32chars"

# (Tuỳ chọn) Địa chỉ website công khai dùng khi xuất mã QR bàn, vd: https://huongviet.vn
# Bỏ trống = dùng địa chỉ đang mở trang Admin. Khi chạy local, điện thoại khách cần IP LAN (vd http://192.168.1.10:3000), không dùng localhost.
NEXT_PUBLIC_SITE_URL=""
